// Sales analytics semantic model — E2E fixture for Dot's Malloy connector.
// Star schema over the `sales` Postgres schema: orders → order_items → products,
// orders → customers, plus regional targets from an imported file.
import "regions.malloy"

source: customers is pg.table('sales.customers') extend {
  primary_key: customer_id
  // Region can be NULL for a handful of legacy customers.
  measure: customer_count is count()
}

source: products is pg.table('sales.products') extend {
  primary_key: product_id
  dimension: price_band is
    pick 'premium' when unit_price >= 40
    pick 'standard' when unit_price >= 15
    else 'budget'
  measure: product_count is count()
}

source: order_items is pg.table('sales.order_items') extend {
  primary_key: order_item_id
  join_one: products with product_id
  dimension: discount_pct is discount * 100
  measure:
    line_revenue is sum(quantity * unit_price * (1 - discount))
    units_sold is sum(quantity)
}

source: orders is pg.table('sales.orders') extend {
  primary_key: order_id
  join_one: customers with customer_id
  join_many: order_items on order_id = order_items.order_id

  dimension:
    order_year is year(order_date)
    order_month is order_date.month

  measure:
    order_count is count()
    revenue is order_items.line_revenue
    distinct_customers is count(customer_id)

  view: by_region is {
    group_by: customers.region
    aggregate: revenue, order_count
    order_by: revenue desc
  }

  view: monthly_trend is {
    group_by: order_month
    aggregate: revenue, order_count
    order_by: order_month asc
  }
}

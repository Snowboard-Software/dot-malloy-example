// UK residential property prices — HM Land Registry "Price Paid" data, 1995–2026.
// A Malloy semantic model over Dot's FoxDB warehouse (db.getdot.ai).
//
// The connection is named `foxdb`; Dot injects the warehouse credentials at query
// time, so no secrets live in this repo. Postgres tables are schema-qualified
// (`public.<table>`). Columns that collide with Malloy keywords (`month`, `year`,
// `quarter`, `type`) are referenced with backticks.

source: dim_calendar is foxdb.table('public.dim_calendar') extend {
  #" Calendar dimension (one row per day). Join the monthly fact on month_start.
  primary_key: month_start
}

source: property_sales is foxdb.table('public.fact_monthly_sales') extend {
  #" UK residential property sales, pre-aggregated to month x location x property attributes (~5.5M rows, Jan 1995 - Feb 2026).

  // One calendar row per monthly bucket, so year/quarter are queryable.
  join_one: calendar is dim_calendar on `month` = calendar.month_start

  //---- Dimensions ----
  dimension:
    #" Calendar year of sale.
    sale_year is calendar.`year`
    #" Calendar quarter (1-4).
    sale_quarter is calendar.`quarter`
    #" Property type: detached, semi-detached, terraced, flat, or other.
    property_type is `type`
    #" Tenure: freehold, leasehold, or unknown.
    tenure is duration
    #" True when the sale was a new build.
    is_new_build is is_new

  //---- Measures ----
  measure:
    #" Number of property transactions.
    transaction_count is sum(transactions)
    #" Total monetary value of sales, GBP.
    total_sales_value is sum(total_value)
    #" Value-weighted average sale price, GBP (total value / transactions).
    avg_sale_price is sum(total_value) / sum(transactions)
    #" Highest single recorded sale price in the slice, GBP.
    max_sale_price is max(max_price)

  //---- Reusable views ----
  #" Volume and average price by county, busiest first.
  view: by_county is {
    group_by: county
    aggregate: transaction_count, avg_sale_price
    order_by: transaction_count desc
  }

  #" Volume and average price by property type.
  view: by_property_type is {
    group_by: property_type
    aggregate: transaction_count, avg_sale_price
    order_by: transaction_count desc
  }

  #" Average price and volume per year — the headline house-price trend.
  view: price_trend_by_year is {
    group_by: sale_year
    aggregate: avg_sale_price, transaction_count
    order_by: sale_year
  }

  #" New-build vs existing-property volume and price.
  view: new_vs_existing is {
    group_by: is_new_build
    aggregate: transaction_count, avg_sale_price
  }

  #" Top 20 towns by transaction volume.
  view: top_towns is {
    group_by: town
    aggregate: transaction_count, avg_sale_price
    order_by: transaction_count desc
    limit: 20
  }
}
